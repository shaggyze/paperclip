{{- /*
  Renders every secret in the project/environment/path below as KEY=VALUE.
  Edit the project slug, environment and path to match your Infisical project.
  Typical keys: BETTER_AUTH_SECRET, DATABASE_URL, ANTHROPIC_API_KEY, OPENAI_API_KEY,
  GITHUB_TOKEN, plus anything your agents need (e.g. Nexon test-account creds).
  Values must be single-line; they are read literally (no shell expansion).
*/ -}}
{{- with listSecretsByProjectSlug "paperclip" "prod" "/" `{"recursive": false, "expandSecretReferences": true}` }}
{{- range . }}
{{ .Key }}={{ .Value }}
{{- end }}
{{- end }}
